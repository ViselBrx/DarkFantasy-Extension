  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9BAFCB",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D0B3FF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A5F9DF"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#D3A9FF"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#E8B9FF"
      }
    },
    {
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#A69AFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#A4F0FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B0CEFF"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#8BBEFF"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#D4DFFF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#B7F7FF"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#8BBEFF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.constant.property-value",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#A69AFF"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#D3A9FF"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#C9D7EC"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#9E5678"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F0C58F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A5F9DF"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#8BBEFF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#C9D7EC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#AEF4D0"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FA83B3"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#B0CEFF",
    "interface": "#B0CEFF",
    "type": "#B0CEFF",
    "enum": "#B0CEFF",
    "enumMember": "#E8B9FF",
    "namespace": "#8BBEFF",
    "typeParameter": "#A69AFF",
    "function": "#A4F0FF",
    "method": "#A4F0FF",
    "macro": "#F0C58F",
    "decorator": "#D3A9FF",
    "event": "#F0C58F",
    "parameter": "#D4DFFF",
    "property": "#ECF4FF",
    "property.readonly": "#8BBEFF",
    "variable.readonly": "#8BBEFF"
  }
}
